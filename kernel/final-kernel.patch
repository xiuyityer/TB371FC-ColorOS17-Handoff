+	.ret_type	= RET_PTR_TO_RINGBUF_RECORD_OR_NULL,
+	.arg1_type	= ARG_CONST_MAP_PTR,
+	.arg2_type	= ARG_CONST_RINGBUF_SIZE,
+	.arg3_type	= ARG_ANYTHING,
+};
